<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared control styles for the interview-flow look (docs/03-ui-spec.md §3.0).
       Control chrome may differ from the browser original (acceptable);
       colors/spacing follow the slate palette in Themes/Theme.axaml. -->

  <!-- Primary action: indigo→purple gradient, 12px radius -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <!-- Secondary: slate-800 pill -->
  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="#1E293B" />
    <Setter Property="Foreground" Value="#CBD5E1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#334155" />
  </Style>

  <!-- Destructive -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="#DC2626" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#EF4444" />
  </Style>

  <!-- Quiet icon button (sidebar header) -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1E293B" />
  </Style>

  <!-- Form field: slate-950 well with slate-800 border -->
  <Style Selector="TextBox.field">
    <Setter Property="Background" Value="{StaticResource PageBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="#F1F5F9" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <!-- Typing indicator while a chat turn is in flight (§3.0 .typing-dot). -->
  <Style Selector="TextBlock.typingDots">
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Sidebar "this section is running" spinner (§3.1): the original's
       animate-spin arc, one turn per second, replacing the tile glyph. -->
  <Style Selector="Path.spinner">
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="INFINITE" Easing="LinearEasing">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Amber cog pulse while no AI provider is configured (§3.1). The original
       also scales 1→1.25; opacity-only is an accepted approximation (transform
       keyframes aren't animatable from styles). -->
  <Style Selector="TextBlock.cogPulse">
    <Setter Property="Foreground" Value="#F59E0B" />
    <Style.Animations>
      <Animation Duration="0:0:1.8" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.45" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
