<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InterviewFlow.App.App"
             RequestedThemeVariant="Dark">
  <!-- The original app is dark-only (slate palette); Fluent supplies control chrome,
       Theme.axaml supplies the interview-flow palette. -->
  <!-- Resources FIRST: AppStyles resolves theme brushes via StaticResource at
       parse time, so the palette must already be in scope. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://InterviewFlow.App/Themes/Theme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://InterviewFlow.App/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
