<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InterviewFlow.App.ViewModels"
             x:Class="InterviewFlow.App.Views.AgentRunHeaderView"
             x:DataType="vm:AgentRunViewModel">
  <!-- Split Run button + queue dropdown (§3.4). Dropdown ticks are a pending
       selection; only Apply enqueues/unqueues. -->
  <StackPanel Orientation="Horizontal" Spacing="1">
    <Button Classes="primary" CornerRadius="12,0,0,12"
            Content="{Binding RunState.Label}"
            IsEnabled="{Binding RunState.IsEnabled}"
            Command="{Binding RunCommand}" />
    <Button Classes="primary" CornerRadius="0,12,12,0" Padding="10,10">
      <TextBlock Text="▾" FontSize="12" />
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedRight" Opened="OnQueueFlyoutOpened">
          <StackPanel MinWidth="240" Spacing="2">
            <TextBlock Text="Queue sections" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="4,2,4,6" />
            <ItemsControl ItemsSource="{Binding DropdownItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:QueueDropdownItemViewModel">
                  <Grid ColumnDefinitions="*,Auto">
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              IsEnabled="{Binding IsEnabled}"
                              FontSize="13" Padding="6,2">
                      <TextBlock Text="{Binding Title}" />
                    </CheckBox>
                    <TextBlock Grid.Column="1" Text="running" FontSize="11" Foreground="#FBBF24"
                               VerticalAlignment="Center" Margin="8,0,4,0"
                               IsVisible="{Binding IsRunning}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="1" Margin="0,8,0,8"
                    Background="{StaticResource PanelBorderBrush}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="4,0,4,2">
              <Button Classes="subtle" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" FontSize="13"
                      Content="{Binding SelectAllLabel}"
                      Command="{Binding ToggleSelectAllCommand}" />
              <Button Grid.Column="1" Classes="primary" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" FontSize="13"
                      CornerRadius="8" Padding="12,8"
                      Content="Apply" Click="OnApplyClick" />
            </Grid>
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>
  </StackPanel>
</UserControl>
