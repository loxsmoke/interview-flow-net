<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="using:InterviewFlow.App.ViewModels.Pages"
             xmlns:models="using:InterviewFlow.Core.Models"
             xmlns:controls="using:InterviewFlow.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="820"
             x:Class="InterviewFlow.App.Views.ResumePageView"
             x:DataType="pages:ResumePageViewModel"
             x:Name="Root"
             DragDrop.AllowDrop="True">
  <Design.DataContext>
    <pages:ResumePageViewModel />
  </Design.DataContext>

  <!-- Resume screen (§3.3). -->
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Classes="primary" Content="Save &amp; Continue →"
              Command="{Binding SaveAndContinueCommand}" VerticalAlignment="Top" />
      <StackPanel>
        <TextBlock Text="Resume" FontSize="24" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock Text="Upload or select resume" FontSize="13"
                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
      </StackPanel>
    </DockPanel>

    <Expander Grid.Row="1" Header="{Binding SavedHeader}" Margin="0,0,0,12"
              IsExpanded="{Binding SavedExpanded, Mode=TwoWay}"
              Background="{StaticResource PanelBackgroundBrush}"
              BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
              CornerRadius="12" HorizontalAlignment="Stretch">
      <ItemsControl ItemsSource="{Binding SavedResumes}" Margin="4">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:Resume">
            <Grid ColumnDefinitions="Auto,12,*,Auto" Margin="8,4">
              <Button Grid.Column="0" Classes="subtle" Content="Select"
                      Command="{Binding #Root.((pages:ResumePageViewModel)DataContext).SelectSavedCommand}"
                      CommandParameter="{Binding}" />
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Description}" FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding CreatedAt}" FontSize="11" Foreground="#64748B" />
              </StackPanel>
              <Button Grid.Column="3" Classes="danger" Content="Delete"
                      Command="{Binding #Root.((pages:ResumePageViewModel)DataContext).DeleteSavedCommand}"
                      CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>

    <!-- Upload zone -->
    <Border Grid.Row="2" Margin="0,0,0,12" Padding="16"
            Background="Transparent" BorderBrush="#334155" BorderThickness="1"
            CornerRadius="12" x:Name="DropZone">
      <StackPanel Spacing="6" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
          <Button Classes="subtle" Content="Choose file…" Click="OnPickFile" />
          <TextBlock Text="or drag &amp; drop — PDF, DOCX, TXT, MD (max 10 MB)"
                     FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding UploadedInfo}" FontSize="11" Foreground="#64748B"
                   HorizontalAlignment="Center"
                   IsVisible="{Binding UploadedInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding UploadError}" FontSize="12" Foreground="#F87171"
                   HorizontalAlignment="Center" TextWrapping="Wrap"
                   IsVisible="{Binding UploadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <!-- Editor card -->
    <Border Grid.Row="3" Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="12">
      <TabControl SelectedIndex="{Binding SelectedTab}">
        <TabItem Header="Edit">
          <TextBox Classes="field" Text="{Binding TaggedText}" AcceptsReturn="True"
                   TextWrapping="Wrap" VerticalContentAlignment="Top"
                   FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12" />
        </TabItem>
        <TabItem Header="Raw format">
          <ScrollViewer>
            <SelectableTextBlock Text="{Binding RawText}" FontSize="11" TextWrapping="Wrap"
                                 FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                                 Foreground="{StaticResource TextMutedBrush}" Margin="4" />
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Preview">
          <DockPanel>
            <CheckBox DockPanel.Dock="Top" Content="Show contact info" FontSize="12"
                      IsChecked="{Binding ShowContact}" Margin="4,0,0,8" />
            <ScrollViewer>
              <controls:TaggedResumePreview TaggedText="{Binding TaggedText}"
                                            ShowContact="{Binding ShowContact}"
                                            ContactName="{Binding ContactName}"
                                            ContactInfo="{Binding ContactInfo}"
                                            Margin="8" MaxWidth="740"
                                            HorizontalAlignment="Left" />
            </ScrollViewer>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Border>

    <!-- Footer: insert tag + export + save to library -->
    <StackPanel Grid.Row="4" Spacing="8" Margin="0,12,0,0">
      <Border Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="8"
              Padding="12,8" IsVisible="{Binding HasExportPath}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="subtle" Padding="8,4" FontSize="11"
                  Content="📂 Open folder" Command="{Binding OpenExportFolderCommand}" />
          <TextBlock Text="{Binding ExportedPath, StringFormat='Exported to {0}'}" FontSize="12"
                     Foreground="#BAE6FD" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
          <Button Background="#0369A1" Foreground="White" CornerRadius="8" Padding="12,8"
                  Content="Export .docx" Command="{Binding ExportDocxCommand}" />
          <Button Background="#166534" Foreground="White" CornerRadius="8" Padding="12,8"
                  Content="Save to library" Command="{Binding SaveToLibraryCommand}" />
        </StackPanel>
        <ComboBox PlaceholderText="Insert tag…" MinWidth="280" FontSize="12"
                  ItemsSource="{Binding InsertTags}" SelectionChanged="OnInsertTagSelected"
                  x:Name="TagCombo" HorizontalAlignment="Left" />
      </DockPanel>
    </StackPanel>
  </Grid>
</UserControl>
