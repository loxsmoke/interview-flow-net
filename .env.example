# Interview Flow settings — copy to .env in this folder and fill in.
# Shared format with the original Python app (docs/adr/ADR-002): you can point
# both apps at the same file. NEVER commit .env — it holds API keys.

# Which provider runs the agents: anthropic | openai | gemini | ollama
ACTIVE_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
# Note: Google retired gemini-2.5-flash for new API keys — use a current id.
GEMINI_MODEL=gemini-3.6-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Empty = the model's default context window; otherwise 4096 … 262144.
OLLAMA_NUM_CTX=

# Used for the .docx export header.
RESUME_NAME=
RESUME_CONTACT=

# Where workflows are stored. Empty = ./data next to this file when it exists,
# otherwise the per-user application data folder.
INTERVIEW_DATA_DIR=

# Optional: export agent-query traces over OTLP (replaces the original's Langfuse).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
